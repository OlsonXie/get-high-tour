{
  "primitive": {
    "color": {
      "green-track": {
        "$type": "color",
        "$value": "#6DAE8A"
      },
      "red-track": {
        "$type": "color",
        "$value": "#E0504A"
      },
      "yellow-track": {
        "$type": "color",
        "$value": "#E8B24E"
      },
      "blue-flat": {
        "$type": "color",
        "$value": "#3B7DD8"
      },
      "neutral-950": {
        "$type": "color",
        "$value": "#11161D"
      },
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "violet-300": {
        "$type": "color",
        "$value": "#B79AF2"
      },
      "violet-700": {
        "$type": "color",
        "$value": "#5A2BC4"
      },
      "avalanche-2": {
        "$type": "color",
        "$value": "#F2C200",
        "$description": "Varsom danger level 2 (yellow)"
      },
      "avalanche-3": {
        "$type": "color",
        "$value": "#F07F1A",
        "$description": "Varsom danger level 3 (orange)"
      }
    },
    "fontFamily": {
      "archivo-black": {
        "$type": "fontFamily",
        "$value": [
          "Archivo Black",
          "Arial Black",
          "system-ui",
          "sans-serif"
        ]
      },
      "montserrat": {
        "$type": "fontFamily",
        "$value": [
          "Montserrat",
          "system-ui",
          "sans-serif"
        ]
      }
    }
  },
  "semantic": {
    "track": {
      "skin": {
        "$type": "color",
        "$value": "{primitive.color.green-track}",
        "$description": "Skins up – all ascent walked with skins"
      },
      "descent": {
        "$type": "color",
        "$value": "{primitive.color.red-track}",
        "$description": "Descent – the single solid downhill line"
      },
      "flat": {
        "$type": "color",
        "$value": "{primitive.color.blue-flat}",
        "$description": "Flat / counter-slope on the descent, drawn thicker"
      },
      "bootpack": {
        "$type": "color",
        "$value": "{primitive.color.yellow-track}",
        "$description": "Boot pack – skis carried on the back"
      },
      "casing": {
        "$type": "color",
        "$value": "{primitive.color.neutral-950}",
        "$description": "Dark halo under every track line, for contrast on all basemaps"
      },
      "halo": {
        "$type": "color",
        "$value": "{primitive.color.white}",
        "$description": "Halo behind labels on the track (e.g. flat stretch length and angle)"
      }
    },
    "heat": {
      "low": {
        "$type": "color",
        "$value": "{primitive.color.violet-300}",
        "$description": "Heatmap base: few known tracks"
      },
      "high": {
        "$type": "color",
        "$value": "{primitive.color.violet-700}",
        "$description": "Heatmap base: many known tracks, and OSM ski tracks"
      }
    },
    "aval": {
      "start": {
        "$type": "color",
        "$value": "{primitive.color.avalanche-3}",
        "$description": "Avalanche terrain along the route: start zone (hatched area)"
      },
      "other": {
        "$type": "color",
        "$value": "{primitive.color.avalanche-2}",
        "$description": "Avalanche terrain along the route: below a start zone / terrain trap (hatched area)"
      },
      "hatch": {
        "$type": "color",
        "$value": "{primitive.color.neutral-950}",
        "$description": "Diagonal hatching on avalanche terrain"
      }
    },
    "font": {
      "heading": {
        "$type": "fontFamily",
        "$value": "{primitive.fontFamily.archivo-black}",
        "$description": "Headings (test 2026-11-23, was Instrument Serif)"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{primitive.fontFamily.montserrat}",
        "$description": "Body text and buttons"
      }
    }
  }
}
